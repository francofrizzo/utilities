#!/usr/bin/env python3

import sys
import os
from openai import OpenAI
import keyring


def get_api_key():
    return keyring.get_password("openai", "api_key")


def transcribe_audio(client, file_path):
    if not os.path.isfile(file_path):
        print(f"Error: File '{file_path}' does not exist.")
        sys.exit(1)

    with open(file_path, "rb") as audio_file:
        response = client.audio.transcriptions.create(
            model="whisper-1",
            file=audio_file
        )
    return response.text.strip()


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: transcribe <audio_file_path>")
        sys.exit(1)

    api_key = get_api_key()
    if not api_key:
        print("Error: OpenAI API key not found. Store it using keyring.set_password().")
        sys.exit(1)

    client = OpenAI(api_key=api_key)

    file_path = sys.argv[1]
    print(transcribe_audio(client, file_path))
