#!/usr/bin/env python3

import sys
from openai import OpenAI
import keyring


def get_api_key():
    return keyring.get_password("openai", "api_key")


def get_emojis(client, prompt):
    api_key = get_api_key()
    if not api_key:
        print("Error: OpenAI API key not found. Store it using keyring.set_password().")
        sys.exit(1)

    response = client.chat.completions.create(model="gpt-3.5-turbo",
                                              messages=[
                                                  {"role": "system", "content": "You are an assistant that converts text to related emojis."},
                                                  {"role": "user",
                                                      "content": f"Convert this to emojis: {prompt}"}
                                              ],
                                              max_tokens=10)
    return response.choices[0].message.content.strip()


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: emoji <text>")
        sys.exit(1)

    api_key = get_api_key()
    if not api_key:
        print("Error: OpenAI API key not found. Store it using keyring.set_password().")
        sys.exit(1)

    client = OpenAI(api_key=api_key)

    input_text = " ".join(sys.argv[1:])
    print(get_emojis(client, input_text))
